{
  "name": "@rosepetal/node-red-contrib-barcode-reader",
  "version": "1.4.0",
  "description": "Rosepetal multi-decoder barcode scanner for Node-RED: ZBar, ZXing, Quagga2, Rosepetal Projection and the Rosepetal SDK engine",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosepetal-ai/node-red-contrib-barcode-reader.git"
  },
  "keywords": [
    "node-red",
    "barcode",
    "zbar",
    "zxing",
    "quagga2",
    "rosepetal",
    "scanner"
  ],
  "author": "Rosepetal SL (https://www.rosepetal.ai)",
  "contributors": [
    {
      "name": "Víctor González Bentué",
      "email": "victor.gonzalez@rosepetal.ai"
    }
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/rosepetal-ai/node-red-contrib-barcode-reader/issues"
  },
  "homepage": "https://github.com/rosepetal-ai/node-red-contrib-barcode-reader#readme",
  "dependencies": {
    "@ericblade/quagga2": "1.12.1",
    "@rosepetal/barcode-engine-client": "^0.2.0",
    "jpeg-js": "^0.4.4"
  },
  "optionalDependencies": {
    "@rosepetal/node-red-contrib-barcode-reader-linux-arm64": "1.4.0",
    "@rosepetal/node-red-contrib-barcode-reader-linux-x64": "1.4.0",
    "@rosepetal/node-red-contrib-barcode-reader-linuxmusl-x64": "1.4.0"
  },
  "config": {
    "unsafe-perm": true
  },
  "node-red": {
    "version": ">=1.0.0",
    "nodes": {
      "barcode-reader": "node-red-contrib-barcode-reader/barcode.js"
    }
  },
  "devDependencies": {
    "node-red": "5.0.7",
    "node-red-node-test-helper": "0.3.6",
    "pngjs": "7.0.0"
  }
}
